#!/usr/bin/env python3
"""
rfc2217-learn-slots — Discover USB-port-to-slot mapping on any Raspberry Pi.

Works on Pi Zero 2 W, Pi 3, Pi 4, Pi 5, or anything else.  Plug a device
into each USB port you want to use as a slot, then run this tool.  It
prints a ready-to-paste ``testbench.json`` with one slot per detected
USB port, each with a unique TCP and GDB port.

Each slot is the port the board itself is plugged into, so every port of an
external hub (including hubs built from cascaded internal hubs) is its own
slot. Pass --top-level for the old one-slot-per-Pi-port behaviour.
"""

import argparse
import glob
import json
import os
import subprocess
import sys

# usb_slots.py is installed next to this script (/usr/local/bin) and sits next
# to it in the repo (pi/), so the script's own directory finds it either way.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import usb_slots  # noqa: E402


def get_udev_info(devnode):
    try:
        result = subprocess.run(
            ["udevadm", "info", "-q", "all", devnode],
            capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError:
        return None
    props = {}
    for line in result.stdout.splitlines():
        if line.startswith("E: "):
            key, _, value = line[3:].partition("=")
            props[key] = value
    return props


def find_serial_devices():
    devices = []
    for pattern in ("/dev/ttyACM*", "/dev/ttyUSB*"):
        devices.extend(glob.glob(pattern))
    return sorted(devices)


def pi_model():
    try:
        with open("/proc/device-tree/model") as f:
            return f.read().rstrip("\x00").strip()
    except OSError:
        return "Unknown"


def extract_usb_prefix(id_path, top_level=False):
    """Reduce an ID_PATH to the port path used as a slot's usb_prefix.

    The prefix is the port the device itself is plugged into, so each port of
    an external hub becomes its own slot:
      platform-3f980000.usb-usb-0:1.1:1.0     -> 0:1.1    (Pi port, no hub)
      platform-3f980000.usb-usb-0:1.3.4:1.0   -> 0:1.3.4  (hub on Pi port 3, hub port 4)
      pci-0000:01:00.0-usb-0:1.2.1.3:1.2      -> 0:1.2.1.3 (hub with an internal second hub)

    With top_level=True it keeps only the Pi-side port ("0:1.3.4" -> "0:1.3"),
    for a bench whose boards carry their own onboard hub and plug straight
    into the Pi. Behind an external hub that collapses every board into one
    slot, which is why it is no longer the default.
    """
    path = usb_slots.port_path(id_path)
    if path is None:
        return None
    return usb_slots.top_level(path) if top_level else path


def main():
    ap = argparse.ArgumentParser(description=__doc__.strip().splitlines()[0])
    ap.add_argument("--top-level", action="store_true",
                    help="one slot per Pi port, merging everything behind a hub "
                         "(only for boards with an onboard hub, no external hub)")
    args = ap.parse_args()

    print(f"Raspberry Pi model: {pi_model()}\n")

    devices = find_serial_devices()
    if not devices:
        print("No serial devices found (ttyACM* or ttyUSB*).")
        print("Plug at least one device into a USB port and try again.")
        sys.exit(1)

    print(f"Found {len(devices)} serial device(s):\n")

    slots = []
    seen_prefixes = {}
    for devnode in devices:
        props = get_udev_info(devnode)
        if not props:
            print(f"  {devnode}: could not read udev info")
            continue
        id_path = props.get("ID_PATH", "")
        model = props.get("ID_MODEL", "Unknown")
        serial = props.get("ID_SERIAL_SHORT") or props.get("ID_SERIAL", "?")
        prefix = extract_usb_prefix(id_path, args.top_level)

        print(f"  {devnode}")
        print(f"     model  : {model}")
        print(f"     serial : {serial}")
        print(f"     id_path: {id_path}")
        print(f"     prefix : {prefix}")
        print()

        if not prefix:
            continue
        # A board with two serial interfaces (two ttys) is one USB device on
        # one port, so it gives one prefix. Two *different* boards with the
        # same prefix only happen with --top-level behind a hub.
        if prefix in seen_prefixes and seen_prefixes[prefix] != serial:
            print(f"  WARNING: {devnode} ({serial}) shares {prefix} with "
                  f"{seen_prefixes[prefix]}: they would be one slot\n")
        seen_prefixes.setdefault(prefix, serial)

    # Build suggested config with slots numbered in the order they were discovered
    for i, prefix in enumerate(sorted(seen_prefixes, key=usb_slots.sort_key), start=1):
        slots.append({
            "label": f"SLOT{i}",
            "usb_prefix": prefix,
            "tcp_port": 4000 + i,
            "gdb_port": 3332 + i,
            "openocd_telnet_port": 4443 + i,
        })

    if not slots:
        print("No usable slots discovered.")
        sys.exit(1)

    config = {
        "gpio_boot": 18,
        "gpio_en": 17,
        "slots": slots,
        "debug_probes": [],
    }

    print("=" * 60)
    print("Suggested /etc/rfc2217/testbench.json:")
    print("=" * 60)
    print(json.dumps(config, indent=2))
    print()
    print("To install:")
    print("  sudo cp <paste-to-file>.json /etc/rfc2217/testbench.json")
    print("  sudo systemctl restart rfc2217-portal")


if __name__ == "__main__":
    main()
