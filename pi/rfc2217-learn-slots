#!/usr/bin/env python3
"""
rfc2217-learn-slots — Discover USB-port-to-slot mapping on any Raspberry Pi.

Works on Pi Zero 2 W, Pi 3, Pi 4, Pi 5, or anything else.  Plug a device
into each USB port you want to use as a slot, then run this tool.  It
prints a ready-to-paste ``testbench.json`` with one slot per detected
USB port, each with a unique TCP and GDB port.

Each slot is the port the board itself is plugged into, so every port of an
external hub (including hubs built from cascaded internal hubs) is its own
slot. Pass --top-level for the old one-slot-per-Pi-port behaviour.
"""

import argparse
import glob
import json
import os
import re
import subprocess
import sys

# usb_slots.py is installed next to this script (/usr/local/bin) and sits next
# to it in the repo (pi/), so the script's own directory finds it either way.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import usb_slots  # noqa: E402


def get_udev_info(devnode):
    try:
        result = subprocess.run(
            ["udevadm", "info", "-q", "all", devnode],
            capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError:
        return None
    props = {}
    for line in result.stdout.splitlines():
        if line.startswith("E: "):
            key, _, value = line[3:].partition("=")
            props[key] = value
    return props


def find_serial_devices():
    devices = []
    for pattern in ("/dev/ttyACM*", "/dev/ttyUSB*"):
        devices.extend(glob.glob(pattern))
    return sorted(devices)


def pi_model():
    try:
        with open("/proc/device-tree/model") as f:
            return f.read().rstrip("\x00").strip()
    except OSError:
        return "Unknown"


def extract_usb_prefix(id_path, top_level=False):
    """Reduce an ID_PATH to the port path used as a slot's usb_prefix.

    The prefix is the port the device itself is plugged into, so each port of
    an external hub becomes its own slot:
      platform-3f980000.usb-usb-0:1.1:1.0     -> 0:1.1    (Pi port, no hub)
      platform-3f980000.usb-usb-0:1.3.4:1.0   -> 0:1.3.4  (hub on Pi port 3, hub port 4)
      pci-0000:01:00.0-usb-0:1.2.1.3:1.2      -> 0:1.2.1.3 (hub with an internal second hub)

    With top_level=True it keeps only the Pi-side port ("0:1.3.4" -> "0:1.3"),
    for a bench whose boards carry their own onboard hub and plug straight
    into the Pi. Behind an external hub that collapses every board into one
    slot, which is why it is no longer the default.
    """
    path = usb_slots.port_path(id_path)
    if path is None:
        return None
    return usb_slots.top_level(path) if top_level else path


def hub_siblings(prefix):
    """The other ports of the hub *prefix* hangs on, that hold no hub.

    Empty ports become slots too, so a board plugged in later lands in a slot
    of its own. Ports with a hub on them are not slots: their ports are.
    """
    bus, _, ports = prefix.partition(":")
    parts = ports.split(".")
    if len(parts) < 2:
        return []
    parent = f"{int(bus) + 1}-{'.'.join(parts[:-1])}"
    base = f"/sys/bus/usb/devices/{parent}"
    try:
        with open(f"{base}/maxchild") as f:
            n = int(f.read().strip())
    except (OSError, ValueError):
        return []
    out = []
    for k in range(1, n + 1):
        child = f"{base}.{k}"
        try:
            with open(f"{child}/bDeviceClass") as f:
                if f.read().strip() == "09":
                    continue
        except OSError:
            pass  # empty port
        out.append(f"{bus}:{'.'.join(parts[:-1])}.{k}")
    return out


def discover(top_level=False, include_empty=False, quiet=False):
    """One {"usb_prefix", "serial"} per occupied port (and per empty sibling
    port with include_empty), plus the per-device report unless quiet."""
    say = (lambda *a: None) if quiet else print
    devices = find_serial_devices()
    seen = {}
    for devnode in devices:
        props = get_udev_info(devnode)
        if not props:
            say(f"  {devnode}: could not read udev info")
            continue
        id_path = props.get("ID_PATH", "")
        model = props.get("ID_MODEL", "Unknown")
        serial = props.get("ID_SERIAL_SHORT") or props.get("ID_SERIAL", "?")
        prefix = extract_usb_prefix(id_path, top_level)
        say(f"  {devnode}")
        say(f"     model  : {model}")
        say(f"     serial : {serial}")
        say(f"     id_path: {id_path}")
        say(f"     prefix : {prefix}")
        say()
        if not prefix:
            continue
        # A board with two serial interfaces (two ttys) is one USB device on
        # one port, so it gives one prefix. Two *different* boards with the
        # same prefix only happen with --top-level behind a hub.
        if prefix in seen and seen[prefix] != serial:
            print(f"  WARNING: {devnode} ({serial}) shares {prefix} with "
                  f"{seen[prefix]}: they would be one slot\n", file=sys.stderr)
        seen.setdefault(prefix, serial)
    if include_empty and not top_level:
        for prefix in list(seen):
            for sib in hub_siblings(prefix):
                seen.setdefault(sib, "")
    return [{"usb_prefix": p, "serial": seen[p]}
            for p in sorted(seen, key=usb_slots.sort_key)]


def main():
    ap = argparse.ArgumentParser(description=__doc__.strip().splitlines()[0])
    ap.add_argument("--top-level", action="store_true",
                    help="one slot per Pi port, merging everything behind a hub "
                         "(only for boards with an onboard hub, no external hub)")
    ap.add_argument("--include-empty", action="store_true",
                    help="also make slots of the empty ports on the hubs the "
                         "boards are plugged into")
    ap.add_argument("--merge", metavar="TESTBENCH_JSON",
                    help="fold the ports into this existing config, keeping its "
                         "labels, TCP/GDB ports, GPIO pins and debug probes")
    ap.add_argument("--pin", action="append", default=[], metavar="LABEL=SERIAL",
                    help="put LABEL on the port of the board with this USB serial "
                         "(an ESP32-S3's is its MAC), e.g. SLOT1=48:27:E2:EA:48:3C")
    ap.add_argument("--console", action="append", default=[], metavar="LABEL=VID:PID",
                    help="make the serial device with this USB VID:PID the slot's "
                         "console and ignore the others on its port path, e.g. "
                         "SLOT2=1a86:55d3 (a CH343 beside a modem); LABEL= removes it")
    ap.add_argument("--json", action="store_true",
                    help="print only the resulting config (for scripts)")
    args = ap.parse_args()

    pins = {}
    for item in args.pin:
        label, sep, serial = item.partition("=")
        if not sep or not label or not serial:
            ap.error(f"--pin wants LABEL=SERIAL, got {item!r}")
        pins[label] = serial

    consoles = {}
    for item in args.console:
        label, sep, vid_pid = item.partition("=")
        vid_pid = vid_pid.strip().lower()
        if (not sep or not label
                or (vid_pid and not re.fullmatch(r"[0-9a-f]{4}:[0-9a-f]{4}", vid_pid))):
            ap.error(f"--console wants LABEL=VID:PID (e.g. SLOT2=1a86:55d3), got {item!r}")
        consoles[label] = vid_pid

    if not args.json:
        print(f"Raspberry Pi model: {pi_model()}\n")
        print(f"Found {len(find_serial_devices())} serial device(s):\n")
    learned = discover(args.top_level, args.include_empty, quiet=args.json)
    if not learned:
        print("No serial devices found (ttyACM* or ttyUSB*). Plug at least one "
              "device into a USB port and try again.", file=sys.stderr)
        sys.exit(1)

    existing = None
    if args.merge:
        try:
            with open(args.merge) as f:
                existing = json.load(f)
        except FileNotFoundError:
            existing = None
        except (OSError, ValueError) as exc:
            print(f"cannot read {args.merge}: {exc}", file=sys.stderr)
            sys.exit(1)

    config, notes = usb_slots.merge_config(existing, learned, pins, consoles)
    if args.json:
        for n in notes:
            print(f"note: {n}", file=sys.stderr)
        print(json.dumps(config, indent=2))
        return

    for n in notes:
        print(f"  {n}")
    print("=" * 60)
    print("Suggested /etc/rfc2217/testbench.json:")
    print("=" * 60)
    print(json.dumps(config, indent=2))
    print()
    print("To install (or run update-bench.sh, which does all of this):")
    print("  sudo cp <paste-to-file>.json /etc/rfc2217/testbench.json")
    print("  sudo systemctl restart rfc2217-portal")


if __name__ == "__main__":
    main()
